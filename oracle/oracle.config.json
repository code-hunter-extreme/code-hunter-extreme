{
  "_comment": "Synced from code-hunter shared config.json",
  "scan": {
    "platforms": "all",
    "refresh_cache": false,
    "cdp_port": 9227
  },
  "filter": {
    "min_payout_usd": 500,
    "max_payout_usd": 0,
    "max_resolved_reports": 100,
    "fast_triage_only": false,
    "new_programs_only": false,
    "new_program_days": 90,
    "web2": true,
    "web3": true,
    "pick_per_platform": 5,
    "top_n": 50
  },
  "hunt": {
    "auto": false,
    "verify": true,
    "cloud": true,
    "testnet": false,
    "download_assets": true,
    "screenshot": true,
    "code_lens": true,
    "max_cards_per_family": 20,
    "recon_context": {
      "max_hosts": 20,
      "max_endpoints": 30
    }
  },
  "queue": {
    "order": "finish-site",
    "concurrent": false,
    "cross_site_cap": 3,
    "default_count": 5
  },
  "researcher": {
    "handle": "testhunter",
    "note": "Researcher handle used in compliance request headers"
  },
  "quality_gates": {
    "gate_precision_min": 0.7,
    "gate_recall_min": 1.0,
    "gate_clean_fp_max": 0.1,
    "gate_cases": 60
  },
  "platform_auth": {
    "hackerone": {
      "methods": [
        "api_key",
        "cdp_session",
        "public"
      ],
      "api_key_env": "HACKERONE_API_KEY"
    },
    "bugcrowd": {
      "methods": [
        "cdp_session",
        "public"
      ]
    },
    "intigriti": {
      "methods": [
        "api_key",
        "cdp_session",
        "public"
      ],
      "api_key_env": "INTIGRITI_JWT"
    },
    "yeswehack": {
      "methods": [
        "public",
        "cdp_session"
      ]
    },
    "immunefi": {
      "methods": [
        "public"
      ]
    },
    "hackenproof": {
      "methods": [
        "api_key",
        "cdp_session",
        "public"
      ],
      "api_key_env": "HACKENPROOF_API_KEY"
    }
  }
}
